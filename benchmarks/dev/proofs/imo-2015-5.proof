sub P: y:=1
sub P: x:=0
splitnz f(0)
sub P: y:=0
sub P: x:=-1, y:=1
sub P: x:=1, y:=-1
sub P: x:=1
sub [f(x + f(x)) = x + f(x)]: x:=x+1
sub [f(f(x + 1) + 1) = f(x + 1) - f(x) + x + 1]: x:=x+f(x+1)
sub [f(f(x + 1) + x + 2) = f(x + 1) + x + 2]: x:=x-2
sub P: y:=-1
sub P: x:=-1, y:=-x
conclude
sub [f(f(x)) = f(x) + f(0)*x - f(0)]: x:=x+f(x+1)
conclude
