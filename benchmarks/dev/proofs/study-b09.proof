sub P: y:=0
sub [f(f(x)) = f(0)*f(x) + f(x)]: x:=x+y
splitnz f(0)
sub [f(x)*f(y) = xy]: x:=1, y:=1
split [f(1)^2 = 1]
sub [f(x)*f(y) = xy]: y:=1
conclude
sub [f(x)*f(y) = xy]: y:=1
conclude
sub [f(x)*f(y) = f(0)*f(x+y) + xy]: y:=-x
sub [f(f(x)) = f(0)*f(x) + f(x)]: x:=0
sub [f(x)*f(-x) = f(0)^2 - x^2]: x:=f(0)
split [f(0)*f(-f(0)) = -f(-f(0))]
sub [f(x)*f(y) = f(0)*f(x+y) + xy]: y:=-f(0)
conclude
sub [f(x)*f(y) = f(0)*f(x+y) + xy]: y:=-1
conclude
